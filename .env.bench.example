# Benchmark and Tier 2 check settings. Copy to .env.bench and fill in. Never commit it.
# Never passed to the notary container. Empty counts as unset.

# --- Shared with the notary (same values as in .env.notary) ---
SWITCH_URL=
SWITCH_GATEWAY_URL=
SWITCH_GATEWAY_KEY=
PROXENOS_URL=http://127.0.0.1:8080
PROXENOS_OPERATOR_TOKEN=
# The notary's `sender` id (state blocks are trusted only from it) and its agent store id.
PROXENOS_NOTARY_SENDER_ID=
NOTARY_AGENT_ID=

# --- Benchmark live runs (`proxenos-bench --arm` / `--play`) ---
# The subject CLIs read their own login (ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN;
# OPENAI_API_KEY or CODEX_HOME) from the environment.
# Negotiators' agent store ids (`/agents/{id}`) and keys: credentials and policies only.
BENCH_BUYER_AGENT_ID=
BENCH_BUYER_AGENT_KEY=
BENCH_SELLER_AGENT_ID=
BENCH_SELLER_AGENT_KEY=
# The `sender` id on each negotiator's messages; the notary binds these (live check L19).
BENCH_BUYER_SENDER_ID=
BENCH_SELLER_SENDER_ID=
# Owners' Gateway usernames (for admit) and the `sender` id on each owner's messages.
BENCH_BUYER_OWNER_ID=
BENCH_SELLER_OWNER_ID=
BENCH_BUYER_OWNER_SENDER_ID=
BENCH_SELLER_OWNER_SENDER_ID=
# The injector agent, used when Mattermost REST posting (L11) is not available.
BENCH_INJECTOR_AGENT_ID=
BENCH_INJECTOR_AGENT_KEY=
BENCH_DEAL_ROOM=
BENCH_BUYER_DESK=
BENCH_SELLER_DESK=

# --- Tier 2 checks (scripts/check_refusal.sh, scripts/check_party_gate.sh) ---
# check_party_gate.sh with CHECK_REMOVE_RULE=1 also needs SWITCH_AGENT_ID (the notary).
# Mattermost base URL and the deal room's channel id.
MM_URL=
MM_DEAL_CHANNEL_ID=
# Personal access tokens: the counterparty (refusal check), a non-party member and a bound owner.
MM_COUNTERPARTY_TOKEN=
MM_NONPARTY_TOKEN=
MM_PARTY_TOKEN=
# Deal id for the party-gate check, and the negotiator's agent id for printing its policy.
DEAL_ID=
NEGOTIATOR_AGENT_ID=
