# Notary settings (`proxenos serve`, `admit`, `fixture`). Copy to .env.notary and fill in.
# docker compose passes only this file to the notary container. Never commit it.
# Empty counts as unset. Generate each 64-hex key with: openssl rand -hex 32

# --- Required ---
# AES-256-GCM key for sealed limits (64 hex). Losing it makes sealed limits unreadable;
# the notary refuses to start if it does not open the deals already in the database.
PROXENOS_VAULT_KEY=
# HMAC key for seal tokens and join codes (64 hex).
PROXENOS_SECRET_KEY=
# Switch server base URL, for the notary's agent connection.
SWITCH_URL=
# The notary's agent id and API key, written by the one-time `proxenos register` (always_on
# profile, registration key minted by the operator).
SWITCH_AGENT_ID=
SWITCH_AGENT_KEY=
# The `sender` id Switch puts on the notary's own messages; usually not SWITCH_AGENT_ID.
# Post one message as the notary and copy `sender` from the first live event (live check L19).
PROXENOS_NOTARY_SENDER_ID=
# Switch server base for the Gateway (it lives under /gateway). Must be https unless loopback
# or PROXENOS_ALLOW_HTTP_GATEWAY=1.
SWITCH_GATEWAY_URL=
# The operator's Gateway API key (or session JWT); used to update the notary's addressing policy.
SWITCH_GATEWAY_KEY=
# The Mattermost bridge (collaboration) id, for looking up owners' external user ids.
SWITCH_BRIDGE_ID=
# The operator's display name exactly as Switch carries it in a kickoff's on_behalf_of
# (for example `user`), not a user id. Compared exactly.
PROXENOS_OPERATOR_ID=
# Bearer token for the operator HTTP endpoints and `proxenos admit` (at least 16 characters).
PROXENOS_OPERATOR_TOKEN=

# --- Optional (defaults shown; docker-compose sets ADDR, DB and the key file itself) ---
# Base URL printed in seal links; defaults to http://<PROXENOS_ADDR>. Set it whenever the
# notary listens on 0.0.0.0 (always in Docker), or the links cannot be opened.
PROXENOS_PUBLIC_URL=http://localhost:8080
# Accept a plain-http SWITCH_GATEWAY_URL off loopback (e.g. http://host.docker.internal:8000
# from Docker). The operator key then travels unencrypted; the notary warns at startup.
# PROXENOS_ALLOW_HTTP_GATEWAY=0
# Receipt signing seed (64 hex); without it the seed is read from, or created in, the key file.
# The notary refuses to create a new key file while bound deals exist.
# PROXENOS_RECEIPT_KEY=
# PROXENOS_RECEIPT_KEY_FILE=proxenos-receipt.key
# PROXENOS_DB=proxenos.db
# PROXENOS_ADDR=127.0.0.1:8080
# Post sign cards as well as accepting the typed sign (true or false).
# PROXENOS_SIGN_CARDS=false
# Comma-separated relay participant ids that may never become negotiators.
# PROXENOS_RELAY_IDS=
# The notary's agent name in rooms.
# PROXENOS_NOTARY_NAME=notary
# Lifetime of every deal in seconds.
# PROXENOS_DEAL_SECS=86400
# Round cap (2 to 50) for kickoff deals and for POST /api/deals bodies without max_rounds.
# PROXENOS_MAX_ROUNDS=8

# --- Operator CLI ---
# Running notary for `proxenos admit`; admit also reads PROXENOS_OPERATOR_TOKEN.
PROXENOS_URL=http://127.0.0.1:8080
# `proxenos fixture`: seal tokens (or pass --buyer-seal-file / --seller-seal-file) and the
# `sender` ids of both owners and both negotiators.
FIXTURE_BUYER_SEAL=
FIXTURE_SELLER_SEAL=
FIXTURE_BUYER_OWNER_ID=
FIXTURE_SELLER_OWNER_ID=
FIXTURE_BUYER_AGENT_ID=
FIXTURE_SELLER_AGENT_ID=
